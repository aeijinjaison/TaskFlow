# Copy this file to ".env" and fill in real values (npm run setup does this for you).
# NEVER commit the real .env file.

PORT=5000
NODE_ENV=development

# Local MongoDB (use 127.0.0.1, not "localhost" - avoids IPv6 issues on Node 18+)
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS (comma separated for several)
CLIENT_URL=http://localhost:5173
